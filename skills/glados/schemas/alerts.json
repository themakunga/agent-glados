{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "permission": { "$ref": "#/$defs/pool" },
    "input": { "$ref": "#/$defs/pool" }
  },
  "required": ["permission", "input"],
  "additionalProperties": false,
  "$defs": {
    "pool": {
      "type": "array",
      "minItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 150,
        "pattern": "^(?!.*[\\x00-\\x1f\\x7f])\\S+(?: \\S+)*$"
      }
    }
  }
}
